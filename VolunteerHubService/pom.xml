<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>volunteerhub</groupId>
    <artifactId>VolunteerHubService</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>VolunteerHubService</name>
    <!-- a war (web archive) is the format a Jakarta EE server such as Payara can deploy -->
    <packaging>war</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Jakarta EE 10 web profile (REST, CDI, JSON-B, JSON-P): "provided" because Payara already contains it -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- our domain model: install it first (Maven tab > VolunteerHubDomain > Lifecycle > install) -->
        <dependency>
            <groupId>volunteerhub</groupId>
            <artifactId>VolunteerHubDomain</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <!-- produces target/VolunteerHubService.war, so the URLs start with /VolunteerHubService -->
        <finalName>VolunteerHubService</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
